#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        col_semi: col_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COL_SEMI";
            bindings = <&kp COLON>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        home_row_mod_left: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <100>;
            quick-tap-ms = <200>;
            hold-trigger-key-positions = <6 18 30 31 19 7 8 9 10 11 20 21 22 23 32 33 34 35>;
            hold-while-undecided;
        };

        home_row_mod_right: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-while-undecided;
            flavor = "tap-unless-interrupted";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;
            tapping-term-ms = <100>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB    &kp Q                              &kp W                          &kp E                            &kp R                       &kp T        &kp Y    &kp U                        &kp I                         &kp O                            &kp P      &kp BSPC
&kp LCTRL  &home_row_mod_left LEFT_COMMAND A  &home_row_mod_left LEFT_ALT S  &home_row_mod_left LEFT_SHIFT D  &home_row_mod_left LCTRL F  &kp G        &kp H    &home_row_mod_right RCTRL J  &home_row_mod_right RSHIFT K  &home_row_mod_right RIGHT_ALT L  &col_semi  &kp SQT
&kp LSHFT  &kp Z                              &kp X                          &kp C                            &kp V                       &kp B        &kp N    &kp M                        &kp COMMA                     &kp DOT                          &kp FSLH   &kp ESC
                                                                             &kp LGUI                         &mo 1                       &kp SPACE    &kp RET  &mo 2                        &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp TAB  &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR        &kp PERCENT       &kp CARET        &kp AMPERSAND      &kp STAR  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BSPC
&trans   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4      &kp N5            &kp NUMBER_6     &kp NUMBER_7       &kp N8    &kp N9                &kp N0                 &trans
&trans   &trans        &trans        &trans        &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans    &kp GRAVE             &kp TILDE              &trans
                                     &kp LGUI      &trans            &kp SPACE         &kp RET          &trans             &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp TAB    &kp EXCL  &kp AT    &kp PLUS   &kp EQUAL  &kp PRCNT    &kp C_PREV      &kp C_PLAY_PAUSE  &kp C_NEXT    &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP
&kp LCTRL  &kp LPAR  &kp RPAR  &kp MINUS  &kp UNDER  &kp PIPE     &kp LEFT_ARROW  &kp DOWN_ARROW    &kp UP_ARROW  &kp RIGHT   &kp GRAVE     &kp BACKSLASH
&trans     &trans    &trans    &kp LG(C)  &kp LG(V)  &trans       &bt BT_SEL 0    &bt BT_SEL 1      &bt BT_SEL 2  &bt BT_CLR  &kp PIPE      &kp ESCAPE
                               &kp LGUI   &trans     &kp SPACE    &kp RET         &trans            &kp RALT
            >;
        };
    };
};
